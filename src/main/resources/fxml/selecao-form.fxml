<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>


<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.projetocopa.controllersJavaFX.SelecaoFormController"
      spacing="10"      
      prefWidth="300.0"
      alignment="CENTER_LEFT">

	<padding>
        <Insets top="10" right="10" bottom="15" left="15"/>
    </padding>
    
    <Label text="Nome de Seleção"/>

    <TextField fx:id="txtNome" promptText="Nome"/>

    <Button text="Salvar" onAction="#salvar" defaultButton="true"/>

</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.projetocopa.controllersJavaFX.TelaInicialController">

    <top>
        <MenuBar>
            <Menu text="Cadastros">
                <MenuItem text="Seleções" onAction="#abrirSelecoes"/>
                <MenuItem text="Estádios" onAction="#abrirEstadios"/>
                <MenuItem text="Partidas" onAction="#abrirPartidas"/>
            </Menu>
        </MenuBar>
    </top>
    
    <center>
        <StackPane fx:id="conteudo"/>
    </center>

</BorderPane>
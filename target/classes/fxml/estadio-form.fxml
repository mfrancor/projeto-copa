<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.projetocopa.controllersJavaFX.EstadioFormController"
      spacing="10"      
      prefWidth="300.0"
      alignment="CENTER_LEFT">

	<padding>
        <Insets top="10" right="10" bottom="15" left="15"/>
    </padding>
    
    <Label text="Cadastro de Estádio">
    	<font>
	        <Font size="16"/>
	    </font>
    </Label>
    
    <Label text="Nome"/>
    <TextField fx:id="txtNome" promptText="Nome"/>
    
    <Label text="Cidade"/>
    <TextField fx:id="txtCidade" promptText="Cidade"/>
    
    
    <Button text="Salvar" onAction="#salvar" defaultButton="true"/>

</VBox>